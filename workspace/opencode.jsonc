{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "__MAXSTACK_WORKSPACE__/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "__MAXSTACK_WORKSPACE__/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "__MAXSTACK_WORKSPACE_WSL__/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "__MAXSTACK_WORKSPACE_WSL__/.opencode/*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "timeout": {
      "startup": 120000
    }
  }
}
