{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "<workspace>/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "<workspace>/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "<workspace>/.opencode/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "<workspace>/.opencode/*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "timeout": {
      "startup": 120000
    },
    "servers": {}
  },
  "plugin": [
    "./.opencode/plugins/pstack/opencode"
  ]
}